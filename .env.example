# UMNIA — contoh environment (JANGAN isi rahasia di sini, dan JANGAN commit .env)
# Salin ke .env untuk dev lokal: cp .env.example .env

APP_ENV=development

# Business API (F1-01; default di kode adalah :8080)
HTTP_LISTEN_ADDR=:8080

# Frontend (Nuxt) — alamat business-api yang dipakai browser
NUXT_PUBLIC_API_BASE=http://localhost:8080

# Database (F1-02) — isi dari .env lokal, JANGAN commit password asli.
# Format: postgres://umnia_business/<password>@localhost:5432/umnia_business?sslmode=disable
BUSINESS_DATABASE_URL=
# Admin plane terpisah; TIDAK boleh disuntikkan ke business-api.
ADMIN_DATABASE_URL=
# Windows Compose saja: password akun bootstrap superuser (migrasi),
# TERPISAH dari password akun runtime di atas. Jangan samakan keduanya
# dengan akun API; API tidak boleh memakai akun bootstrap.
UMNIA_BUSINESS_BOOTSTRAP_PASSWORD=
UMNIA_ADMIN_BOOTSTRAP_PASSWORD=

# Storage (RustFS, F1-02) — endpoint lokal default di bawah; kredensial
# lewat referensi, bukan key mentah di file ini.
STORAGE_DRIVER=s3
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=umnia-dev
STORAGE_REGION=us-east-1
STORAGE_CREDENTIAL_REF=

# Opsional, default mati (lihat ADR-013).
REDIS_ENABLED=false
PGBOUNCER_ENABLED=false
OUTBOX_BACKEND=postgres
