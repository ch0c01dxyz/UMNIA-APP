# UMNIA — contoh environment (JANGAN isi rahasia di sini, dan JANGAN commit .env)
# Salin ke .env untuk dev lokal: cp .env.example .env

APP_ENV=development

# Business API (F1-01; default di kode adalah :8080)
HTTP_LISTEN_ADDR=:8080

# Frontend (Nuxt) — alamat business-api yang dipakai browser
NUXT_PUBLIC_API_BASE=http://localhost:8080

# Database — BELUM dipakai F1-01, baru dipasang di F1-02. Biarkan kosong.
BUSINESS_DATABASE_URL=
# Admin plane terpisah; TIDAK boleh disuntikkan ke business-api.
ADMIN_DATABASE_URL=

# Storage (RustFS, F1-02) — belum dipakai F1-01.
STORAGE_DRIVER=
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_CREDENTIAL_REF=

# Opsional, default mati (lihat ADR-013).
REDIS_ENABLED=false
PGBOUNCER_ENABLED=false
OUTBOX_BACKEND=postgres
