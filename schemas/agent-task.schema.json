{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://umnia.example/schemas/agent-task.schema.json",
  "title": "UMNIA Flash-ready Task Packet",
  "type": "object",
  "additionalProperties": false,
  "required": ["id","phase","risk","priority","title","objective","dependencies","read_first","allowed_files","forbidden_changes","implementation_steps","acceptance","test_commands","evidence_required","escalate_when","review_required","status"],
  "properties": {
    "id":{"type":"string","pattern":"^UMN-P[0-8]-[0-9]{3}$"},
    "phase":{"type":"string","pattern":"^P[0-8]$"},
    "risk":{"enum":["T0","T1","T2","T3"]},
    "priority":{"enum":["P0","P1","P2"]},
    "title":{"type":"string","minLength":5},
    "objective":{"type":"string","minLength":20},
    "dependencies":{"type":"array","items":{"type":"string"},"uniqueItems":true},
    "read_first":{"type":"array","minItems":1,"items":{"type":"string"}},
    "allowed_files":{"type":"array","minItems":1,"items":{"type":"string"}},
    "forbidden_changes":{"type":"array","minItems":1,"items":{"type":"string"}},
    "implementation_steps":{"type":"array","minItems":2,"items":{"type":"string"}},
    "acceptance":{"type":"array","minItems":2,"items":{"type":"string"}},
    "test_commands":{"type":"array","minItems":1,"items":{"type":"string"}},
    "evidence_required":{"type":"array","minItems":1,"items":{"type":"string"}},
    "escalate_when":{"type":"array","minItems":1,"items":{"type":"string"}},
    "review_required":{"type":"boolean"},
    "status":{"enum":["PLANNED","READY","IN_PROGRESS","REVIEW","DONE","BLOCKED"]},
    "notes":{"type":"string"}
  }
}
