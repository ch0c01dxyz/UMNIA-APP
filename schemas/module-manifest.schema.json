{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://umnia.example/schemas/module-manifest.schema.json",
  "title": "UMNIA Module Manifest v0.4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "family",
    "edition",
    "display",
    "provides",
    "requires",
    "conflicts",
    "exclusive_group",
    "data_ownership",
    "simulation_dataset",
    "security"
  ],
  "properties": {
    "schema_version": {
      "const": "0.4"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9-]*)+$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "family": {
      "type": "string",
      "minLength": 2
    },
    "edition": {
      "type": "string",
      "enum": [
        "basic",
        "advanced",
        "standard"
      ]
    },
    "exclusive_group": {
      "type": [
        "string",
        "null"
      ]
    },
    "display": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name_id",
        "description_id"
      ],
      "properties": {
        "name_id": {
          "type": "string",
          "minLength": 2
        },
        "description_id": {
          "type": "string"
        }
      }
    },
    "provides": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/capability"
      }
    },
    "requires": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "capability"
        ],
        "properties": {
          "capability": {
            "$ref": "#/$defs/capability"
          },
          "optional": {
            "type": "boolean",
            "default": false
          }
        }
      }
    },
    "conflicts": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "data_ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemas",
        "downgrade_strategy"
      ],
      "properties": {
        "schemas": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "downgrade_strategy": {
          "type": "string",
          "enum": [
            "retain_read_only",
            "retain_shared",
            "requires_manual_review"
          ]
        }
      }
    },
    "simulation_dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "schema_id",
        "validation_profile",
        "refresh_policy"
      ],
      "properties": {
        "required": {
          "const": true
        },
        "schema_id": {
          "type": "string",
          "minLength": 3
        },
        "validation_profile": {
          "type": "string",
          "minLength": 3
        },
        "refresh_policy": {
          "type": "string",
          "enum": [
            "on_module_change_and_scheduled",
            "on_module_change_only",
            "manual_with_review"
          ]
        }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "risk_class",
        "needs_approval_for_mutations"
      ],
      "properties": {
        "risk_class": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "needs_approval_for_mutations": {
          "type": "boolean"
        }
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "primary_nav": {
          "type": "string"
        },
        "display_policy": {
          "type": "string"
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "capability": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9_-]*)+$"
    }
  }
}
